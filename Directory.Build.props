<Project>
  <PropertyGroup>
    <ReleaseVersion Condition="'$(ReleaseVersion)' == ''">development</ReleaseVersion>
    <DefineConstants Condition="'$(DevelopmentUpdateTesting)' == 'true'">$(DefineConstants);FH_UPDATE_TESTING</DefineConstants>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ReleaseVersion" Value="$(ReleaseVersion)" />
    <AssemblyMetadata Include="UpdateSignerCertificateSha256" Value="$(UpdateSignerCertificateSha256)" Condition="'$(UpdateSignerCertificateSha256)' != ''" />
  </ItemGroup>
  <PropertyGroup Condition="'$(ProductVersion)' != ''">
    <Version>$(ProductVersion)</Version>
    <FileVersion>$(ProductVersion)</FileVersion>
    <InformationalVersion>$(ProductVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Fluff-History</Product>
    <Company>Fish &amp; Dog Software</Company>
  </PropertyGroup>
  <!-- Preserve the five private libraries' pre-M25.3 binding identity; PE/file/product
       release metadata still follows ProductVersion. Executables retain their existing
       exact assembly version (the Agent exposes that value in its status). -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'FluffHistory.Core' or '$(MSBuildProjectName)' == 'FluffHistory.Storage' or '$(MSBuildProjectName)' == 'FluffHistory.Engine' or '$(MSBuildProjectName)' == 'FluffHistory.Application' or '$(MSBuildProjectName)' == 'FluffHistory.Windows'">
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>
</Project>
