<UserControl x:Class="FluffHistory.Desktop.Presentation.PageLayout"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Padding="{StaticResource PagePadding}">
  <Grid MaxWidth="{StaticResource PageContentMaxWidth}" HorizontalAlignment="Stretch">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ContentPresenter x:Name="HeaderHost" HorizontalContentAlignment="Stretch"/>
   <Grid x:Name="BodyHost" Grid.Row="1"/>
   <ContentPresenter x:Name="FooterHost" Grid.Row="2" HorizontalContentAlignment="Stretch"/>
  </Grid>
 </Grid>
</UserControl>
