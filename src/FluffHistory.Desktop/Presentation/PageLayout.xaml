<UserControl x:Class="FluffHistory.Desktop.Presentation.PageLayout"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid HorizontalAlignment="Stretch">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ContentPresenter x:Name="HeaderHost" MaxWidth="{StaticResource PageContentMaxWidth}" Margin="24,20,24,0" HorizontalContentAlignment="Stretch"/>
   <Grid x:Name="BodyHost" Grid.Row="1"/>
   <ContentPresenter x:Name="FooterHost" MaxWidth="{StaticResource PageContentMaxWidth}" Margin="24,0,24,20" Grid.Row="2" HorizontalContentAlignment="Stretch"/>
  </Grid>
 </Grid>
</UserControl>
