<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FluffHistory.Desktop.Presentation">
 <local:BooleanVisibilityConverter x:Key="VisibleWhen" />
 <local:FolderIconConverter x:Key="FolderIcon" />
 <local:RetentionSeverityConverter x:Key="RetentionSeverity" />
 <x:Double x:Key="DriveUsageHeight">10</x:Double>
 <!-- 300 DIPs leaves a modest margin within the minimum intended 320-DIP content column.
      Text may wrap, but its glyph measurements never size the gauge. -->
 <x:Double x:Key="DriveUsageWidth">300</x:Double>
 <Style x:Key="DriveUsageBar" TargetType="ProgressBar">
  <Setter Property="Height" Value="{StaticResource DriveUsageHeight}"/>
  <Setter Property="MinHeight" Value="{StaticResource DriveUsageHeight}"/>
  <Setter Property="CornerRadius" Value="5"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="MaxWidth" Value="{StaticResource DriveUsageWidth}"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/>
  <Setter Property="Minimum" Value="0"/>
  <Setter Property="Maximum" Value="100"/>
  <Setter Property="IsIndeterminate" Value="False"/>
 </Style>
 <Style x:Key="DriveUsageTrack" TargetType="Border">
  <Setter Property="Height" Value="{StaticResource DriveUsageHeight}"/>
  <Setter Property="CornerRadius" Value="5"/>
  <Setter Property="Background" Value="{ThemeResource ProgressBarBackground}"/>
 </Style>
 <Style x:Key="DriveUsageContainer" TargetType="StackPanel">
  <Setter Property="Width" Value="{StaticResource DriveUsageWidth}"/>
  <Setter Property="HorizontalAlignment" Value="Left"/>
  <Setter Property="Spacing" Value="6"/>
 </Style>
 <Style x:Key="FullRowItem" TargetType="ListViewItem">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="VerticalContentAlignment" Value="Stretch"/>
 </Style>
 <Style x:Key="FullTileItem" TargetType="GridViewItem">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="VerticalContentAlignment" Value="Stretch"/>
 </Style>
 <Thickness x:Key="PagePadding">24,20,24,20</Thickness>
 <x:Double x:Key="PageContentMaxWidth">960</x:Double>
 <Style x:Key="PageSections" TargetType="StackPanel">
  <Setter Property="Spacing" Value="16"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/>
 </Style>
 <Thickness x:Key="PageTitleMargin">0,0,0,24</Thickness>
 <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
  <Setter Property="TextWrapping" Value="Wrap" />
  <Setter Property="Margin" Value="{StaticResource PageTitleMargin}" />
 </Style>
 <Style x:Key="SectionHeading" TargetType="StackPanel">
  <Setter Property="Orientation" Value="Horizontal"/>
  <Setter Property="Spacing" Value="12"/>
 </Style>
 <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
  <Setter Property="TextWrapping" Value="Wrap" />
 </Style>
 <Style x:Key="BodyText" TargetType="TextBlock">
  <Setter Property="TextWrapping" Value="Wrap" />
  <Setter Property="IsTextSelectionEnabled" Value="True" />
 </Style>
 <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
  <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
 </Style>
 <Style x:Key="SectionPanel" TargetType="Border">
  <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
  <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
  <Setter Property="BorderThickness" Value="1" />
  <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
  <Setter Property="Padding" Value="20" />
 </Style>
</ResourceDictionary>
