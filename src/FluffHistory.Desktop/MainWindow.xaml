<Window x:Class="FluffHistory.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:FluffHistory.Desktop.Presentation">
 <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
 <Grid x:Name="RootLayout">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <TitleBar x:Name="AppTitleBar" Title="Fluff-History" IsPaneToggleButtonVisible="True" PaneToggleRequested="ToggleNavigationPane" AutomationProperties.AutomationId="AppTitleBar" />
 <NavigationView x:Name="Navigation" Grid.Row="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" IsEnabled="False" IsSettingsVisible="True" PaneDisplayMode="Auto" OpenPaneLength="240"
                 IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsTitleBarAutoPaddingEnabled="False"
                 CompactModeThresholdWidth="640" ExpandedModeThresholdWidth="1200" SelectionChanged="NavigateChanged">
  <NavigationView.MenuItems>
   <NavigationViewItem loc:Localize.Uid="Navigation_Overview" Tag="Overview" AutomationProperties.AutomationId="NavOverview"><NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon></NavigationViewItem>
   <NavigationViewItem loc:Localize.Uid="Navigation_Timeline" Tag="History" AutomationProperties.AutomationId="NavHistory"><NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon></NavigationViewItem>
   <NavigationViewItem loc:Localize.Uid="Navigation_Configuration" Tag="Configuration" AutomationProperties.AutomationId="NavConfiguration"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon></NavigationViewItem>
   <NavigationViewItem loc:Localize.Uid="Navigation_About" Tag="Diagnostics" AutomationProperties.AutomationId="NavDiagnostics"><NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon></NavigationViewItem>
  </NavigationView.MenuItems>
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <InfoBar x:Name="GlobalNotice" Margin="24,8,24,0" IsOpen="False" IsClosable="False" />
   <Grid x:Name="PageHost" Grid.Row="1" />
  </Grid>
 </NavigationView>
 </Grid>
</Window>
