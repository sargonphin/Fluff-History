<UserControl x:Class="FluffHistory.Desktop.Pages.DiagnosticsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:FluffHistory.Desktop.Presentation" xmlns:presentation="using:FluffHistory.Desktop.Presentation">

 <presentation:PageLayout>

 <presentation:PageLayout.Header>
<TextBlock loc:Localize.Uid="Diagnostics_TextBlock_PageTitle" Style="{StaticResource PageTitle}" />
 </presentation:PageLayout.Header>

 <presentation:PageLayout.Body>
<StackPanel Style="{StaticResource PageSections}">
   <TextBlock loc:Localize.Uid="Diagnostics_TextBlock_PreviewTitle" Style="{StaticResource SectionTitle}" />
   <TextBlock loc:Localize.Uid="Diagnostics_TextBlock_PreviewCapabilities" Style="{StaticResource SecondaryText}" />
   <Button loc:Localize.Uid="Diagnostics_Button_Copy" Command="{x:Bind Model.Copy}" />
   <TextBlock loc:Localize.Uid="Diagnostics_TextBlock_DiagnosticsPrivacy" Style="{StaticResource SecondaryText}" />
   <TextBlock loc:Localize.Uid="Diagnostics_TextBlock_DiagnosticsName" Text="{x:Bind Model.Summary, Mode=OneWay}" Style="{StaticResource BodyText}" FontFamily="Consolas" />
  </StackPanel>
 </presentation:PageLayout.Body>

 </presentation:PageLayout>

</UserControl>
