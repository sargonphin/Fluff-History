<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test host only: use the exact published product's projections/native runtime. -->
    <Reference Include="Microsoft.Windows.ApplicationModel.Resources.Projection" HintPath="$(ProbePayload)/Microsoft.Windows.ApplicationModel.Resources.Projection.dll" />
    <Reference Include="WinRT.Runtime" HintPath="$(ProbePayload)/WinRT.Runtime.dll" />
    <Reference Include="Microsoft.Windows.SDK.NET" HintPath="$(ProbePayload)/Microsoft.Windows.SDK.NET.dll" />
  </ItemGroup>
</Project>
