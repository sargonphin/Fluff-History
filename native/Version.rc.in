#include <windows.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSION_NUMERIC@
 PRODUCTVERSION @VERSION_NUMERIC@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @TYPE@
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "ProductName", "Fluff-History\0"
   VALUE "FileDescription", "@DESCRIPTION@\0"
   VALUE "CompanyName", "Fish & Dog Software\0"
   VALUE "FileVersion", "@VERSION@\0"
   VALUE "ProductVersion", "@VERSION@\0"
   VALUE "Comments", "Source @HEAD@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
